{:min-bb-version "1.12.0"
 :tasks
 {:requires ([babashka.fs :as fs])
  ;; src/clojure is tangled from showcase-clojure.org, with :comments both
  ;; link wrappers that cljfmt would reflow. It's linted here but formatted
  ;; at its org source, so fmt covers only the hand-written dirs.
  :init (do (def src-dirs (filterv fs/directory? ["src/clojure" "test" "dev"]))
            (def fmt-dirs (filterv fs/directory? ["test" "dev"])))

  test    {:doc "Run the test suite on the JVM (clojure -M:test)"
           :task (apply shell "clojure -M:test" *command-line-args*)}

  lint    {:doc "Lint with clj-kondo (fails on errors, reports warnings)"
           :task (apply shell "clojure -M:lint --fail-level error --lint" src-dirs)}

  fmt     {:doc "Check formatting with cljfmt (hand-written dirs only)"
           :task (apply shell "clojure -M:fmt check" fmt-dirs)}

  fmt:fix {:doc "Fix formatting with cljfmt (hand-written dirs only)"
           :task (apply shell "clojure -M:fmt fix" fmt-dirs)}

  check   {:doc "lint + fmt + test (what CI runs)"
           :depends [lint fmt test]}}}
