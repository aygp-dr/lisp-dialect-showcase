{;; The Clojure examples are tangled from showcase-clojure.org into
 ;; src/clojure/*.clj (ns clojure.factorial, clojure.fibonacci, ...), so src/
 ;; is the classpath root. Nothing hand-written goes under src/, because
 ;; `make clean` deletes every file there and `make tangle` regenerates only
 ;; the examples. The specs therefore live in test/showcase/specs.clj.
 :paths ["src"]
 :deps {org.clojure/clojure    {:mvn/version "1.12.6"}
        org.clojure/spec.alpha {:mvn/version "0.5.238"}}

 :aliases
 {;; REPL: clj -M:dev  (dev/user.clj instruments all s/fdef'd fns)
  :dev  {:extra-paths ["dev" "test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; bb test  ->  clojure -M:test
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; bb lint  ->  clojure -M:lint --lint src/clojure test dev
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :main-opts ["-m" "clj-kondo.main"]}

  ;; bb fmt / bb fmt:fix  ->  clojure -M:fmt check|fix test dev
  :fmt  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
         :main-opts ["-m" "cljfmt.main"]}}}
